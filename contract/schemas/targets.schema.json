{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NetRunnerXD/analog-portfolio/contract/schemas/targets.schema.json",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mock": {
      "type": "boolean",
      "description": "true for mock/demo data that is not derived from real layers"
    },
    "body_context": {
      "type": "object",
      "properties": {
        "moon": {
          "type": "object"
        },
        "mars": {
          "type": "object"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              ]
            },
            "unit": {
              "type": "string"
            },
            "citation_url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "citation_url"
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(moon|mars)_[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "short_name": {
            "type": "string",
            "description": "UI context-pill name (contract/target_priors.json)"
          },
          "description": {
            "type": "string",
            "description": "Fact-checked one-line UI meta (spec v0.3 TARGET_META)"
          },
          "body": {
            "enum": [
              "moon",
              "mars"
            ]
          },
          "role": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lon_convention": {
                "const": "east-positive, -180..180"
              },
              "source_url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "lat",
              "lon",
              "source_url"
            ]
          },
          "sample_radius_km": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    }
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "citation_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "citation_url"
              ]
            },
            "description": "Literature values (temperature_range, illumination, slope, thermal_inertia, ice, elevation, radiation). null = sample in pipeline."
          },
          "context_values": {
            "type": "object",
            "description": "Nearby or card-only facts; never scored as the target's value"
          },
          "status": {
            "enum": [
              "artemis-9",
              "moon-base-i",
              "mission-site",
              "starship-candidate",
              "ground-truth",
              "optional"
            ]
          },
          "window_offset": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "bearing_deg": {
                    "type": "number"
                  },
                  "distance_km": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "bearing_deg",
                  "distance_km"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[0-9]+[a-z]?$"
            }
          },
          "features": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "t_star": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gap": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "units": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "value",
                "t_star",
                "gap"
              ]
            }
          },
          "dropped_factors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "description": "Target-dependent factors still null after pipeline sampling: dropped for this target, weights renormalised (DATA_CONTRACT 3.2 item 5)"
          },
          "card": {
            "type": "object",
            "description": "Display-only attributes, never scored (illumination %, Earth visibility %, gravity, dose)"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "body",
          "role",
          "anchor",
          "sample_radius_km",
          "values"
        ]
      }
    },
    "earth_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "description": "UI source label, e.g. 'From our 0.5 deg Earth grid (NASA POWER ...)'"
            },
            "source": {
              "type": "string"
            },
            "grid": {
              "type": "string"
            },
            "area_weighting": {
              "const": "cos_lat"
            },
            "n_land_cells": {
              "type": "integer",
              "minimum": 0
            },
            "land_area_km2": {
              "type": "number",
              "minimum": 0
            },
            "stats": {
              "type": "object",
              "properties": {
                "ts_mean_k": {
                  "type": "object",
                  "properties": {
                    "units": {
                      "type": "string"
                    },
                    "min": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "cell_id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 259199
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "lon": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "cell_id",
                        "lat",
                        "lon"
                      ]
                    },
                    "max": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "cell_id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 259199
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "lon": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "cell_id",
                        "lat",
                        "lon"
                      ]
                    },
                    "p0_5": {
                      "type": "number"
                    },
                    "p50": {
                      "type": "number"
                    },
                    "p99_5": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "units",
                    "min",
                    "max",
                    "p0_5",
                    "p99_5"
                  ]
                },
                "dt_k": {
                  "type": "object",
                  "properties": {
                    "units": {
                      "type": "string"
                    },
                    "min": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "cell_id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 259199
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "lon": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "cell_id",
                        "lat",
                        "lon"
                      ]
                    },
                    "max": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "cell_id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 259199
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        },
                        "lon": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "cell_id",
                        "lat",
                        "lon"
                      ]
                    },
                    "p0_5": {
                      "type": "number"
                    },
                    "p50": {
                      "type": "number"
                    },
                    "p99_5": {
                      "type": "number"
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "units",
                    "min",
                    "max",
                    "p0_5",
                    "p99_5"
                  ]
                }
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "units": {
                    "type": "string"
                  },
                  "min": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "cell_id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 259199
                      },
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "cell_id",
                      "lat",
                      "lon"
                    ]
                  },
                  "max": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "number"
                      },
                      "cell_id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 259199
                      },
                      "lat": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "lon": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "cell_id",
                      "lat",
                      "lon"
                    ]
                  },
                  "p0_5": {
                    "type": "number"
                  },
                  "p50": {
                    "type": "number"
                  },
                  "p99_5": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "units",
                  "min",
                  "max",
                  "p0_5",
                  "p99_5"
                ]
              },
              "required": [
                "ts_mean_k",
                "dt_k"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "label",
            "source",
            "area_weighting",
            "n_land_cells",
            "stats"
          ],
          "description": "Earth land extremes from our own grid for the gap panel (coldest 0.5 deg land-cell mean surface temperature, largest diurnal swing) and the clip quantiles"
        },
        {
          "type": "null"
        }
      ]
    },
    "scoring_constants": {
      "type": "object",
      "description": "Full-precision Earth constants for the browser rescorer (earth_clip P0.5/P99.5, F1/F2 range_norm P1/P99, gate inputs); contract v1.2",
      "properties": {
        "earth_clip": {
          "type": "object"
        },
        "range_norm": {
          "type": "object"
        },
        "gates": {
          "type": "object"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "targets"
  ],
  "title": "targets.json (Researcher input superset; shipped file adds features)"
}
