{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NetRunnerXD/analog-portfolio/contract/schemas/targets.schema.json",
  "type": "object",
  "properties": {
    "_schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mock": {
      "type": "boolean",
      "description": "true for mock/demo data that is not derived from real layers"
    },
    "body_context": {
      "type": "object",
      "properties": {
        "moon": {
          "type": "object"
        },
        "mars": {
          "type": "object"
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": [
                      "number",
                      "string"
                    ]
                  }
                }
              ]
            },
            "unit": {
              "type": "string"
            },
            "citation_url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https?://"
                },
                {
                  "type": "null"
                }
              ]
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "citation_url"
          ]
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(moon|mars)_[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "body": {
            "enum": [
              "moon",
              "mars"
            ]
          },
          "role": {
            "type": "string"
          },
          "anchor": {
            "type": "object",
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lon_convention": {
                "const": "east-positive, -180..180"
              },
              "source_url": {
                "type": "string",
                "pattern": "^https?://"
              },
              "note": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "lat",
              "lon",
              "source_url"
            ]
          },
          "sample_radius_km": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    }
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "citation_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^https?://"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "value",
                "unit",
                "citation_url"
              ]
            },
            "description": "Literature values (temperature_range, illumination, slope, thermal_inertia, ice, elevation, radiation). null = sample in pipeline."
          },
          "context_values": {
            "type": "object",
            "description": "Nearby or card-only facts; never scored as the target's value"
          },
          "status": {
            "enum": [
              "artemis-9",
              "moon-base-i",
              "mission-site",
              "starship-candidate",
              "ground-truth",
              "optional"
            ]
          },
          "window_offset": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "bearing_deg": {
                    "type": "number"
                  },
                  "distance_km": {
                    "type": "number"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "bearing_deg",
                  "distance_km"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^R[0-9]+[a-z]?$"
            }
          },
          "features": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "t_star": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "gap": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "units": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "value",
                "t_star",
                "gap"
              ]
            }
          },
          "card": {
            "type": "object",
            "description": "Display-only attributes, never scored (illumination %, Earth visibility %, gravity, dose)"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "body",
          "role",
          "anchor",
          "sample_radius_km",
          "values"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "targets"
  ],
  "title": "targets.json (Researcher input superset; shipped file adds features)"
}
