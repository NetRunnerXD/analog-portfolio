{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NetRunnerXD/analog-portfolio/contract/schemas/portfolio.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mock": {
      "type": "boolean",
      "description": "true for mock/demo data that is not derived from real layers"
    },
    "target_id": {
      "type": "string",
      "pattern": "^(moon|mars)_[a-z0-9_]+$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^P[1-9]_[a-z0-9_]+$"
    },
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "theta": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "universe": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F([1-9]|1[0-3])$"
      }
    },
    "uncoverable": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F([1-9]|1[0-3])$"
      }
    },
    "dropped_factors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F([1-9]|1[0-3])$"
      },
      "description": "Weighted core factors with no target value (e.g. F3 for polar Moon targets); weights renormalised"
    },
    "insufficient_cells": {
      "type": "integer",
      "minimum": 0,
      "description": "Earth cells flagged insufficient_data (< 70% of the active weight present): excluded from ranking, thresholds, pool and robustness"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "enum": [
              "best_match",
              "easiest_to_reach",
              "one_continent"
            ]
          },
          "available": {
            "type": "boolean"
          },
          "unavailable_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "continent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "pool_size": {
            "type": "integer",
            "minimum": 0
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "site_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "name": {
                  "type": "string"
                },
                "lat": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lon": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "cell_id": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 259199
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "score_core": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "earth_percentile": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "factor_scores": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^F([1-9]|1[0-3])$"
                  },
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "covers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^F([1-9]|1[0-3])$"
                  }
                },
                "gaps": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^F([1-9]|1[0-3])$"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "data_coverage": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Share of the active profile weight with Earth data in this cell (scored only if >= 0.7, DATA_CONTRACT 3.2 item 6)"
                },
                "robustness": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "top5_freq": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "robust": {
                          "type": "boolean"
                        },
                        "median_percentile": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        }
                      },
                      "additionalProperties": false,
                      "required": [
                        "top5_freq",
                        "robust"
                      ],
                      "description": "Share of MC draws in which the cell is in the top 5% of land (area-weighted); robust = top5_freq >= 0.8"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "logistics": {
                  "type": "object",
                  "properties": {
                    "travel_time_min": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "within_6h": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "continent": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "airport_km": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "travel_time_min",
                    "within_6h",
                    "continent",
                    "airport_km"
                  ]
                },
                "country": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Natural Earth admin-0 NAME"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "admin1": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Natural Earth admin-1 (state/province) name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "known_analog": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "candidate": {
                  "type": "boolean",
                  "description": "true = new candidate (>300 km from any known analog), needs field confirmation"
                }
              },
              "additionalProperties": false,
              "required": [
                "site_id",
                "name",
                "lat",
                "lon",
                "cell_id",
                "score",
                "factor_scores",
                "covers"
              ]
            },
            "maxItems": 5
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            }
          },
          "coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "available",
          "sites",
          "coverage"
        ]
      }
    },
    "top_cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "cell_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 259199
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score_core": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "earth_percentile": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "factor_scores": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            }
          },
          "gaps": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "data_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Share of the active profile weight with Earth data in this cell (scored only if >= 0.7, DATA_CONTRACT 3.2 item 6)"
          },
          "robustness": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "top5_freq": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "robust": {
                    "type": "boolean"
                  },
                  "median_percentile": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false,
                "required": [
                  "top5_freq",
                  "robust"
                ],
                "description": "Share of MC draws in which the cell is in the top 5% of land (area-weighted); robust = top5_freq >= 0.8"
              },
              {
                "type": "null"
              }
            ]
          },
          "logistics": {
            "type": "object",
            "properties": {
              "travel_time_min": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "within_6h": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "continent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "airport_km": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "travel_time_min",
              "within_6h",
              "continent",
              "airport_km"
            ]
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "Natural Earth admin-0 NAME"
              },
              {
                "type": "null"
              }
            ]
          },
          "admin1": {
            "anyOf": [
              {
                "type": "string",
                "description": "Natural Earth admin-1 (state/province) name"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_analog": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "type": "boolean",
            "description": "true = new candidate (>300 km from any known analog), needs field confirmation"
          }
        },
        "additionalProperties": false,
        "required": [
          "site_id",
          "name",
          "lat",
          "lon",
          "cell_id",
          "score",
          "factor_scores",
          "covers"
        ]
      },
      "description": "Top-ranked candidate pool after NMS (for map pins)"
    },
    "score_histogram": {
      "type": "object",
      "properties": {
        "bins": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "bins",
        "counts"
      ]
    },
    "monte_carlo": {
      "type": "object",
      "properties": {
        "draws": {
          "type": "integer"
        },
        "robust_top_frac": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "robust_min_freq": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "seed": {
          "type": "integer"
        },
        "area_weighting": {
          "const": "cos_lat"
        }
      },
      "additionalProperties": false,
      "required": [
        "draws",
        "robust_top_frac",
        "robust_min_freq",
        "seed"
      ]
    },
    "earth_thresholds": {
      "type": "object",
      "properties": {
        "top5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "top1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "median": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "top5",
        "top1",
        "median"
      ],
      "description": "Area-weighted land quantiles of S (default weights): P95, P99, P50"
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "target_id",
    "profile_id",
    "weights",
    "theta",
    "universe",
    "uncoverable",
    "variants"
  ],
  "title": "portfolios/<target_id>_<profile_id>.json"
}
