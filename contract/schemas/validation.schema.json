{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NetRunnerXD/analog-portfolio/contract/schemas/validation.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mock": {
      "type": "boolean",
      "description": "true for mock/demo data that is not derived from real layers"
    },
    "frozen_commit": {
      "anyOf": [
        {
          "type": "string",
          "description": "git SHA of the pre-registration commit"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "description": "Input CSV (docs/validation.csv)"
    },
    "summary": {
      "type": "object",
      "properties": {
        "n_known": {
          "type": "integer"
        },
        "n_negative": {
          "type": "integer"
        },
        "n_evaluations": {
          "type": "integer"
        },
        "pct_top5": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pct_top1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rank_auc": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "n_scored": {
          "type": "integer",
          "description": "Positive evaluations that passed every filter and the gate"
        },
        "gate_excluded": {
          "type": "object",
          "properties": {
            "sites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "n_evaluations": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "sites",
            "n_evaluations"
          ]
        },
        "land_filter_excluded": {
          "type": "object",
          "properties": {
            "sites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "n_evaluations": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "sites",
            "n_evaluations"
          ]
        },
        "hard_filter_excluded": {
          "type": "object",
          "properties": {
            "sites": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "n_evaluations": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "sites",
            "n_evaluations"
          ]
        },
        "denominators_note": {
          "type": "string"
        },
        "headline_caveat": {
          "type": "string",
          "description": "Pooled headline mixes blind (Moon) and post-hoc (Mars) evaluations"
        },
        "by_body": {
          "type": "object",
          "properties": {
            "moon": {
              "type": "object",
              "properties": {
                "n_evaluations": {
                  "type": "integer"
                },
                "n_scored": {
                  "type": "integer"
                },
                "pct_top5": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "pct_top1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank_auc": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "blind": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "n_evaluations",
                "n_scored",
                "pct_top5",
                "pct_top1",
                "rank_auc",
                "blind",
                "note"
              ]
            },
            "mars": {
              "type": "object",
              "properties": {
                "n_evaluations": {
                  "type": "integer"
                },
                "n_scored": {
                  "type": "integer"
                },
                "pct_top5": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "pct_top1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "rank_auc": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "blind": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "n_evaluations",
                "n_scored",
                "pct_top5",
                "pct_top1",
                "rank_auc",
                "blind",
                "note"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "n_known",
        "n_negative",
        "n_evaluations",
        "pct_top5",
        "pct_top1",
        "rank_auc"
      ]
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "body_analog": {
            "enum": [
              "moon",
              "mars",
              "both",
              "none"
            ]
          },
          "mission_purposes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^P[1-9]_[a-z0-9_]+$"
            },
            "description": "CSV column split on ';' ('none' -> [])"
          },
          "why": {
            "type": "string"
          },
          "citation_url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "kind": {
            "enum": [
              "positive",
              "negative"
            ],
            "description": "negative iff body_analog == 'none'"
          },
          "cell_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 259199
          },
          "eval_cell_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 259199,
            "description": "Cell actually scored: the site's own cell, or the nearest >= 50% land cell within 1 cell"
          },
          "snapped": {
            "type": "boolean"
          },
          "snap_km": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "description": "Great-circle km from the site to the snapped cell centre"
              },
              {
                "type": "null"
              }
            ]
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_id": {
                  "type": "string",
                  "pattern": "^(moon|mars)_[a-z0-9_]+$"
                },
                "profile_id": {
                  "type": "string",
                  "pattern": "^P[1-9]_[a-z0-9_]+$"
                },
                "percentile": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "in_top5": {
                  "type": "boolean"
                },
                "in_top1": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "scored",
                    "gate_excluded",
                    "land_filter_excluded",
                    "hard_filter_excluded",
                    "insufficient_data"
                  ],
                  "description": "scored = passed land/built-up, profile hard filters and the body gate; excluded evaluations stay in the denominators as misses"
                }
              },
              "additionalProperties": false,
              "required": [
                "target_id",
                "profile_id",
                "percentile",
                "in_top5",
                "in_top1"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "lat",
          "lon",
          "body_analog",
          "mission_purposes",
          "why",
          "citation_url",
          "kind",
          "results"
        ]
      }
    },
    "new_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "site_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "cell_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 259199
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "score_core": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "earth_percentile": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "factor_scores": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            }
          },
          "gaps": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^F([1-9]|1[0-3])$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "data_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Share of the active profile weight with Earth data in this cell (scored only if >= 0.7, DATA_CONTRACT 3.2 item 6)"
          },
          "robustness": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "top5_freq": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "robust": {
                    "type": "boolean"
                  },
                  "median_percentile": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "additionalProperties": false,
                "required": [
                  "top5_freq",
                  "robust"
                ],
                "description": "Share of MC draws in which the cell is in the top 5% of land (area-weighted); robust = top5_freq >= 0.8"
              },
              {
                "type": "null"
              }
            ]
          },
          "logistics": {
            "type": "object",
            "properties": {
              "travel_time_min": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "within_6h": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "continent": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "airport_km": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "travel_time_min",
              "within_6h",
              "continent",
              "airport_km"
            ]
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "description": "Natural Earth admin-0 NAME"
              },
              {
                "type": "null"
              }
            ]
          },
          "admin1": {
            "anyOf": [
              {
                "type": "string",
                "description": "Natural Earth admin-1 (state/province) name"
              },
              {
                "type": "null"
              }
            ]
          },
          "known_analog": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "candidate": {
            "type": "boolean",
            "description": "true = new candidate (>300 km from any known analog), needs field confirmation"
          }
        },
        "additionalProperties": false,
        "required": [
          "site_id",
          "name",
          "lat",
          "lon",
          "cell_id",
          "score",
          "factor_scores",
          "covers"
        ]
      }
    },
    "method": {
      "type": "string",
      "description": "Validation method notes (snapping, percentiles, gates)"
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "summary",
    "sites"
  ],
  "title": "validation.json"
}
