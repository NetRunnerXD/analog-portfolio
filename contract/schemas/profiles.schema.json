{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NetRunnerXD/analog-portfolio/contract/schemas/profiles.schema.json",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string"
    },
    "defaults": {
      "type": "object",
      "properties": {
        "theta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nms_radius_km": {
          "type": "number"
        },
        "candidates_top_n_per_factor": {
          "type": "integer"
        },
        "candidate_min_score": {
          "type": "string"
        },
        "portfolio_max_sites": {
          "type": "integer"
        },
        "variants": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "best_match",
                  "easiest_to_reach",
                  "one_continent"
                ]
              },
              "display_name": {
                "type": "string"
              },
              "pool_filter": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "help": {
                "type": "string"
              },
              "unavailable_reason": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "display_name",
              "pool_filter"
            ]
          }
        },
        "monte_carlo": {
          "type": "object",
          "properties": {
            "draws": {
              "type": "integer",
              "minimum": 1
            },
            "dirichlet_alpha_scale": {
              "type": "number"
            },
            "robust_top_frac": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "robust_min_freq": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "area_weighting": {
              "const": "cos_lat"
            },
            "rule": {
              "type": "string"
            },
            "seed": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "required": [
            "draws",
            "dirichlet_alpha_scale",
            "robust_top_frac",
            "robust_min_freq",
            "seed"
          ]
        },
        "secondary_factors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F([1-9]|1[0-3])$"
          }
        },
        "percentiles": {
          "type": "string"
        },
        "nms_distance": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "theta",
        "nms_radius_km",
        "portfolio_max_sites",
        "variants",
        "monte_carlo"
      ]
    },
    "global_hard_filters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "rule": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "ui_short": {
            "type": "string",
            "description": "Legend fragment, e.g. 'mostly water'"
          },
          "ui_tooltip": {
            "type": "string",
            "description": "Tooltip text after 'Filtered out: '"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "rule",
          "reason"
        ]
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P[1-9]_[a-z0-9_]+$"
          },
          "code": {
            "type": "string",
            "pattern": "^P[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string",
            "description": "UI purpose name (spec v0.3 PURPOSE_UI)"
          },
          "display_short": {
            "type": "string"
          },
          "bodies": {
            "type": "array",
            "items": {
              "enum": [
                "moon",
                "mars"
              ]
            },
            "minItems": 1
          },
          "disabled_for": {
            "type": "object"
          },
          "weights": {
            "type": "object",
            "propertyNames": {
              "pattern": "^F([1-9]|10)$"
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            },
            "minProperties": 10,
            "maxProperties": 10
          },
          "theta": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "nms_radius_km": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "hard_filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "rule": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "ui_short": {
                  "type": "string",
                  "description": "Legend fragment, e.g. 'mostly water'"
                },
                "ui_tooltip": {
                  "type": "string",
                  "description": "Tooltip text after 'Filtered out: '"
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "rule",
                "reason"
              ]
            }
          },
          "campaigns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "code",
          "name",
          "display_name",
          "bodies",
          "weights",
          "theta",
          "nms_radius_km",
          "hard_filters"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "contract_version",
    "defaults",
    "global_hard_filters",
    "profiles"
  ],
  "title": "profiles.json"
}
